{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagos.ai/schemas/megalens-run-manifest-1.0.0.json",
  "title": "FlagScale MegaLens run evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "started_at",
    "finished_at",
    "profile",
    "mode",
    "command",
    "config",
    "source",
    "image",
    "execution",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "trace-on",
        "trace-off"
      ]
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "head"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "returncode",
        "timed_out",
        "log"
      ],
      "properties": {
        "returncode": {
          "type": "integer"
        },
        "timed_out": {
          "type": "boolean"
        },
        "log": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "failures",
        "trace"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "evidence"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shards",
            "ranks",
            "event_counts",
            "total_records"
          ],
          "properties": {
            "shards": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "rank",
                  "record_count"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rank": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "record_count": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "ranks": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "event_counts": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "total_records": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
