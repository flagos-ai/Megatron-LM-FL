+def shutdown_megalens_runtime(*, graceful: bool) -> None:
+    """Idempotently close MegaLens before distributed/global teardown."""
+    global _GLOBAL_MEGALENS_RUNTIME
+    runtime = _GLOBAL_MEGALENS_RUNTIME
+    if runtime is None:
+        return
